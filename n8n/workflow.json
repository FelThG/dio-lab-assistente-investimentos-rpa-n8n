    {
      "parameters": {
        "jsCode": "const clientes = new Map();\n\nfor (const item of $input.all()) {\n  const { cliente, produto, minimo, rentabilidade } = item.json;\n\n  const saldo = Number(\n    cliente.saldo\n      .replace(/R\\$\\s*/g, '')\n      .replace(/\\./g, '')\n      .replace(',', '.')\n      .trim()\n  );\n\n  const minimoNumerico = Number(minimo);\n\n  if (\n    !Number.isFinite(saldo) ||\n    !Number.isFinite(minimoNumerico) ||\n    saldo < minimoNumerico\n  ) {\n    continue;\n  }\n\n  if (!clientes.has(cliente.email)) {\n    clientes.set(cliente.email, {\n      cliente,\n      investimentos: [],\n    });\n  }\n\n  clientes.get(cliente.email).investimentos.push({\n    produto,\n    minimo: minimoNumerico,\n    rentabilidade,\n  });\n}\n\nreturn [...clientes.values()].map(dados => ({\n  json: {\n    cliente: {\n      nome: dados.cliente.nome,\n      email: dados.cliente.email,\n    },\n    investimentos: dados.investimentos\n      .sort((a, b) =>\n        b.minimo - a.minimo ||\n        a.produto.localeCompare(b.produto, 'pt-BR')\n      )\n      .slice(0, 2)\n      .map(investimento => ({\n        ...investimento,\n        minimo: investimento.minimo.toLocaleString('pt-BR', {\n          style: 'currency',\n          currency: 'BRL',\n        }),\n      })),\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
